{
  "mcpServers": {
    "claude-flow@alpha": {
      "command": "npx",
      "args": [
        "claude-flow@alpha",
        "mcp",
        "start"
      ],
      "type": "stdio"
    },
    "ruv-swarm": {
      "command": "npx",
      "args": [
        "ruv-swarm@latest",
        "mcp",
        "start"
      ],
      "type": "stdio"
    },
    "flow-nexus": {
      "command": "npx",
      "args": [
        "flow-nexus@latest",
        "mcp",
        "start"
      ],
      "type": "stdio"
    },
    "serena": {
      "command": "uvx",
      "args": [
        "serena",
        "mcp",
        "start",
        "--project",
        "."
      ],
      "type": "stdio"
    }
  }
}
